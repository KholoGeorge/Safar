{
  "lessonId": "ABY 1-1c",
  "unit": 1,
  "topic": "Greetings & Introductions",
  "title": "Country & Nationality (Male)",
  "dialogueAudio": "aby1_1c_dialogue.mp3",
  "phrases": [
    {
      "id": "aby1_1c_01",
      "ar": "السَّلَامُ عَلَيْكُمْ",
      "en": "Peace be upon you",
      "gender": "m",
      "common": true,
      "au": "aby1_1c_01.mp3",
      "notes": "Standard Arabic greeting."
    },
    {
      "id": "aby1_1c_02",
      "ar": "وَعَلَيْكُمُ السَّلَامُ",
      "en": "And upon you be peace",
      "gender": "m",
      "common": true,
      "au": "aby1_1c_02.mp3",
      "notes": "Standard reply to the greeting."
    },
    {
      "id": "aby1_1c_03a",
      "ar": "مِنْ أَيْن أَنْتَ؟",
      "en": "Where are you from?",
      "gender": "m",
      "hint": "to a man",
      "au": "aby1_1c_03a.mp3",
      "notes": "مِنْ أَيْنَ = from where, أَنْتَ = you (masculine)."
    },
    {
      "id": "aby1_1c_03b",
      "ar": "أَنَا مِنْ بَاكِسْتَانَ",
      "en": "I am from Pakistan",
      "gender": "m",
      "au": "aby1_1c_03b.mp3",
      "notes": "بَاكِسْتَانَ ends in fatha due to diptote grammar rule after مِنْ."
    },
    {
      "id": "aby1_1c_04a",
      "ar": "هَلْ أَنْتَ بَاكِسْتَانِيٌّ؟",
      "en": "Are you Pakistani?",
      "gender": "m",
      "hint": "to a man",
      "au": "aby1_1c_04a.mp3",
      "notes": "هَلْ = question marker ('are/is/do')."
    },
    {
      "id": "aby1_1c_04b",
      "ar": "نَعَمْ، أَنَا بَاكِسْتَانِيٌّ",
      "en": "Yes, I am Pakistani",
      "gender": "m",
      "au": "aby1_1c_04b.mp3",
      "notes": "نَعَمْ = yes."
    },
    {
      "id": "aby1_1c_04c",
      "ar": "وَمَا جِنْسِيَّتُكَ أَنْتَ؟",
      "en": "And what is your nationality?",
      "gender": "m",
      "hint": "to a man",
      "au": "aby1_1c_04c.mp3",
      "notes": "جِنْسِيَّتُكَ = your nationality (masculine)."
    },
    {
      "id": "aby1_1c_05a",
      "ar": "أَنَا تُرْكِيٌّ",
      "en": "I am Turkish",
      "gender": "m",
      "au": "aby1_1c_05a.mp3",
      "notes": "Masculine nationality suffix (-ِيّ)."
    },
    {
      "id": "aby1_1c_05b",
      "ar": "أَنَا مِنْ تُرْكِيَا",
      "en": "I am from Turkey",
      "gender": "m",
      "au": "aby1_1c_05b.mp3",
      "notes": "تُرْكِيَا = Turkey."
    },
    {
      "id": "aby1_1c_06",
      "ar": "أَهْلًا وَسَهْلًا",
      "en": "Welcome",
      "gender": "m",
      "common": true,
      "au": "aby1_1c_06.mp3",
      "notes": "Standard expression of welcome."
    }
  ]
}
