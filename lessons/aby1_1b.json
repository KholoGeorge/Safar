      "notes": "Standard Islamic greeting used regardless of recipient gender."
    },
    {
      "ar": "وَعَلَيْكُمُ السَّلَامُ",
      "en": "And upon you be peace.",
      "au": "1_1b_02.mp3",
      "notes": "Standard reply to the greeting."
    },
    {
      "ar": "إِسْمِي خَوْلَةُ",
      "en": "My name is Khawlah.",
      "au": "1_1b_03.mp3",
      "notes": "Feminine proper noun ending in Tā' Marbūṭah (ـَة) taking a single damma (diptote)."
    },
    {
      "ar": "مَا اسْمُكِ ؟",
      "en": "What is your name? (F)",
      "au": "1_1b_04.mp3",
      "notes": "Possessive suffix changes to feminine kasrah (-ki) when addressing a female listener."
    },
    {
      "ar": "إِسْمِي خَدِيجَةُ",
      "en": "My name is Khadijah.",
      "au": "1_1b_05.mp3",
      "notes": "Feminine proper noun ending in Tā' Marbūṭah taking a single damma."
    },
    {
      "ar": "كَيْفَ حَالُكِ ؟",
      "en": "How are you? (F)",
      "au": "1_1b_06.mp3",
      "notes": "Feminine address using the possessive suffix حَالُكِ (ḥāluki)."
    },
    {
      "ar": "بِخَيْرٍ",
      "en": "I am fine.",
      "au": "1_1b_07a.mp3",
      "notes": "Literally 'with goodness'."
    },
    {
      "ar": "وَالْحَمْدُ لِلَّهِ",
      "en": "And praise be to Allah.",
      "au": "1_1b_07b.mp3",
      "notes": "Expression of gratitude to Allah."
    },
    {
      "ar": "وَكَيْفَ حَالُكِ أَنْتِ ؟",
      "en": "And how are you? (F)",
